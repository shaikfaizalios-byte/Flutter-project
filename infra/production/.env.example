# Copy to infra/production/.env on the server and fill in. Never commit the real file.
# Generate secrets with:  openssl rand -base64 48

# Public HTTPS name of the API. Without a domain use <server-ip-with-dashes>.sslip.io,
# e.g. 203-0-113-10.sslip.io (free wildcard DNS that points at that IP).
API_DOMAIN=203-0-113-10.sslip.io
# Let's Encrypt notices (certificate expiry) go here.
ACME_EMAIL=you@example.com

POSTGRES_PASSWORD=change-me-long-random

PREPLOOP_AUTH_SECRET=change-me-at-least-32-random-characters
# The website/web app origin(s) allowed to call the API (no wildcards in production).
PREPLOOP_CORS_ORIGINS=https://shaikfaizalios-byte.github.io

# Email (password reset and verification codes). Production refuses to start without SMTP
# over TLS. Use any provider's SMTP credentials (e.g. Brevo, Amazon SES, Postmark, Mailgun).
PREPLOOP_EMAIL_BACKEND=smtp
PREPLOOP_SMTP_HOST=smtp.example.com
PREPLOOP_SMTP_PORT=587
PREPLOOP_SMTP_SECURITY=starttls
PREPLOOP_SMTP_USERNAME=
PREPLOOP_SMTP_PASSWORD=
PREPLOOP_SMTP_FROM=PrepLoop <no-reply@example.com>

# Optional: AI assistance (review the provider's data terms first) and metrics.
# PREPLOOP_AI_API_KEY=
# PREPLOOP_METRICS_TOKEN=
