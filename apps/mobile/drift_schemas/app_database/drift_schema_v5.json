      "name": "concepts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"concepts\" (\"id\" TEXT NOT NULL, \"exam_code\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"notes\" TEXT NOT NULL DEFAULT '', \"subject\" TEXT NOT NULL, \"topic\" TEXT NOT NULL, \"subtopic\" TEXT NULL, \"language\" TEXT NOT NULL, \"tags\" TEXT NOT NULL DEFAULT '[]', \"source_reference\" TEXT NULL, \"archived_at\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "study_profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"study_profiles\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 1), \"exam_codes\" TEXT NOT NULL DEFAULT '[]', \"target_exam_date\" TEXT NULL, \"daily_study_minutes\" INTEGER NULL, \"reminder_minutes\" INTEGER NULL, \"onboarding_completed_at\" TEXT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
