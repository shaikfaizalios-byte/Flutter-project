# Copy to services/api/.env for local development. Never commit .env files.
PREPLOOP_ENVIRONMENT=development
PREPLOOP_LOG_LEVEL=INFO

# Exact allowed origins, comma-separated (required in staging/production).
PREPLOOP_CORS_ORIGINS=
# Development only: allow the Flutter web dev server on any localhost port.
# Rejected at startup when PREPLOOP_ENVIRONMENT=production.
PREPLOOP_CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1)(:\d+)?$

# PostgreSQL (see docs/database.md). Placeholders only: put real values in .env.
# Without a URL the API still starts; database endpoints return 503.
PREPLOOP_DATABASE_URL=postgresql+psycopg://preploop:CHANGE_ME@127.0.0.1:5432/preploop
# Separate database used by pytest; it is wiped and rebuilt on every test run.
PREPLOOP_TEST_DATABASE_URL=postgresql+psycopg://preploop:CHANGE_ME@127.0.0.1:5432/preploop_test

# --- Document ingestion (see docs/document-ingestion.md) ---
# Where uploaded originals are stored (relative to services/api, gitignored).
PREPLOOP_UPLOAD_DIR=var/uploads
PREPLOOP_MAX_UPLOAD_BYTES=26214400
PREPLOOP_MAX_PDF_PAGES=300
PREPLOOP_UPLOAD_RATE_LIMIT=10
PREPLOOP_UPLOAD_RATE_WINDOW_SECONDS=3600
# Tesseract executable (full path on Windows) and a tessdata dir containing eng + hin.
PREPLOOP_TESSERACT_CMD=tesseract
# PREPLOOP_TESSDATA_DIR=C:/Users/you/.preploop/tessdata
# Run the processing worker inside the API process (local dev). Use false in production
# and run `python -m app.workers.document_worker` separately.
PREPLOOP_DOCUMENT_WORKER_IN_PROCESS=true

# Optional AI assistance (Anthropic Claude). Leave unset to keep AI switched off.
# Put a real key only in your local .env (gitignored); never commit it.
# PREPLOOP_AI_API_KEY=
# PREPLOOP_AI_MODEL=claude-haiku-5-5
# PREPLOOP_AI_TIMEOUT_SECONDS=60
# PREPLOOP_AI_MAX_OUTPUT_TOKENS=4000
# PREPLOOP_AI_RATE_LIMIT=30
# PREPLOOP_AI_RATE_WINDOW_SECONDS=3600
# Reading papers with AI: most pages sent per paper, and page image size (longer side, px).
# PREPLOOP_AI_READ_MAX_PAGES=60
# PREPLOOP_AI_READ_IMAGE_EDGE=1500
# PrepLoop Plus: AI requests per account per month, and free test subscriptions from the app
# (development only; staging/production refuse to start with it on).
# PREPLOOP_PLUS_AI_MONTHLY_ALLOWANCE=300
# PREPLOOP_PLUS_TEST_MODE=true
# AI needs PrepLoop Plus (default). false = AI for everyone; development only.
# PREPLOOP_PLUS_REQUIRED_FOR_AI=true

# Accounts. Required (32+ random characters) in staging/production; in development a random
# secret is generated per process if unset (sign-ins then end when the API restarts).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# PREPLOOP_AUTH_SECRET=
# PREPLOOP_ACCESS_TOKEN_MINUTES=15
# PREPLOOP_REFRESH_TOKEN_DAYS=30
# PREPLOOP_AUTH_RATE_LIMIT=10
# PREPLOOP_AUTH_RATE_WINDOW_SECONDS=900

# Shared rate limits across processes (required in staging/production).
# PREPLOOP_RATE_LIMIT_BACKEND=postgres

# Email for password reset and verification codes. "file" (default) writes .eml files to
# var/outbox for development; staging/production need SMTP (any provider).
# PREPLOOP_EMAIL_BACKEND=smtp
# PREPLOOP_SMTP_HOST=email-smtp.example.com
# PREPLOOP_SMTP_PORT=587
# PREPLOOP_SMTP_SECURITY=starttls
# PREPLOOP_SMTP_USERNAME=
# PREPLOOP_SMTP_PASSWORD=
# PREPLOOP_SMTP_FROM=PrepLoop <no-reply@example.com>

# Prometheus metrics at /api/v1/metrics (bearer token); unset = endpoint hidden.
# PREPLOOP_METRICS_TOKEN=
